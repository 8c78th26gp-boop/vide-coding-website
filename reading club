            const newPost = {
                id: posts.length + 1,
                author: currentUser.name,
                avatar: currentUser.avatar,
                time: "剛剛",
                bookTitle: titleInput.value.trim(),
                bookAuthor: authorInput.value.trim() || "未知作者",
                tag: tagSelect.value,
                rating: currentRating,
                content: contentInput.value.trim(),
                likes: 0,
                likedByMe: false,
                comments: []
