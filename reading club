        function selectChatRoom(roomId) {
            currentActiveChat = roomId;
            const room = chatRooms.find(r => r.id === roomId);
            if (room) {
                room.unread = 0;
                document.getElementById('active-chat-title').innerText = room.name;
                document.getElementById('active-chat-desc').innerText = room.desc;
                document.getElementById('active-chat-icon').innerHTML = `<i class="fa-solid ${room.icon}"></i>`;
            }
            renderChatRooms();
            renderChatMessages();
        }

        function renderChatMessages() {
            const container = document.getElementById('chat-messages-container');
            container.innerHTML = '';

            const msgs = chatMessages[currentActiveChat] || [];
            msgs.forEach(m => {
                const isMe = m.isMe || m.sender === currentUser.name;
                const msgDiv = document.createElement('div');
                msgDiv.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} space-y-1`;
                msgDiv.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-600">${m.sender}</span>
                        <span class="text-[10px] text-slate-400">${m.time}</span>
                    </div>
                    <div class="max-w-xs sm:max-w-md px-4 py-3 rounded-2xl text-sm ${isMe ? 'bg-book-600 text-white rounded-br-none shadow-md' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none shadow-sm'}">
                        ${m.text}
                    </div>
                `;
                container.appendChild(msgDiv);
            });
            container.scrollTop = container.scrollHeight;
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            if (!chatMessages[currentActiveChat]) {
                chatMessages[currentActiveChat] = [];
            }

            const now = new Date();
            const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');

            chatMessages[currentActiveChat].push({
                sender: currentUser.name,
                text: text,
                time: timeStr,
                isMe: true
            });

            input.value = '';
            renderChatMessages();

            // Simulate automatic friendly response in public/dm rooms
            setTimeout(() => {
                let responder = "王曉明";
                if (currentActiveChat === 'chat_2') responder = "陳雅婷";
                if (currentActiveChat === 'psych') responder = "李心怡";

                chatMessages[currentActiveChat].push({
                    sender: responder,
                    text: "完全贊同！這觀點真的讓人很有啟發。👍",
                    time: timeStr,
                    isMe: false
                });
                renderChatMessages();
            }, 1200);
        }

        function handleChatKeyPress(e) {
            if (e.key === 'Enter') {
                sendChatMessage();
            }
        }

