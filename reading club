<!DOCTYPE html>
<html lang="zh-Hant" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>書香知音 | 讀書會心得分享與社交平台</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        book: {
                            50: '#fcf8f2',
                            100: '#f5ebe0',
                            600: '#8c5830',
                            700: '#6f4320',
                            800: '#543216',
                        },
                        amberclub: {
                            DEFAULT: '#d4a373',
                            dark: '#bc8a5f'
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f4f6f8;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="text-slate-800 antialiased flex flex-col min-h-screen">

    <header class="sticky top-0 left-0 w-full bg-white border-b border-slate-200 shadow-sm z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4 flex-1">
                <a href="#" onclick="switchTab('feed')" class="flex items-center gap-2.5 text-book-700 font-extrabold text-xl tracking-wide">
                    <div class="w-10 h-10 bg-book-600 text-white rounded-xl flex items-center justify-center text-xl shadow-md">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>
                    <span class="hidden sm:inline">書香知音</span>
                </a>
                <div class="relative max-w-xs w-full hidden md:block">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-sm"></i>
                    </span>
                    <input type="text" id="global-search" oninput="handleSearch(this.value)" placeholder="搜尋書名、作者、心得或標籤..." class="w-full bg-slate-100 border border-transparent rounded-full pl-10 pr-4 py-2 text-sm focus:bg-white focus:border-book-600 focus:outline-none transition">
                </div>
            </div>

            <!-- Central Navigation Tabs -->
            <nav class="hidden lg:flex items-center justify-center gap-2 flex-1">
                <button onclick="switchTab('feed')" id="nav-btn-feed" class="flex items-center justify-center w-20 h-12 rounded-xl text-book-600 bg-book-50 font-bold text-xl transition hover:bg-book-100" title="動態牆">
                    <i class="fa-solid fa-house"></i>
                </button>
                <button onclick="switchTab('topics')" id="nav-btn-topics" class="flex items-center justify-center w-20 h-12 rounded-xl text-slate-500 font-bold text-xl transition hover:bg-slate-100" title="話題牆">
                    <i class="fa-solid fa-hashtag"></i>
                </button>
                <button onclick="switchTab('chat')" id="nav-btn-chat" class="flex items-center justify-center w-20 h-12 rounded-xl text-slate-500 font-bold text-xl transition hover:bg-slate-100 relative" title="聊天室">
                    <i class="fa-solid fa-comments"></i>
                    <span class="absolute top-2 right-5 w-2.5 h-2.5 bg-red-500 rounded-full"></span>
                </button>
                <button onclick="switchTab('friends')" id="nav-btn-friends" class="flex items-center justify-center w-20 h-12 rounded-xl text-slate-500 font-bold text-xl transition hover:bg-slate-100" title="好友列表">
                    <i class="fa-solid fa-user-group"></i>
                </button>
                <button onclick="switchTab('profile')" id="nav-btn-profile" class="flex items-center justify-center w-20 h-12 rounded-xl text-slate-500 font-bold text-xl transition hover:bg-slate-100" title="個人主頁">
                    <i class="fa-solid fa-id-badge"></i>
                </button>
            </nav>

            <!-- Right Controls -->
            <div class="flex items-center gap-3 justify-end flex-1">
                <button onclick="switchTab('profile')" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-full transition">
                    <img id="current-user-avatar-top" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="頭像" class="w-7 h-7 rounded-full object-cover">
                    <span id="current-user-name-top" class="text-sm font-semibold text-slate-700 hidden sm:inline">林書涵</span>
                </button>
                <button onclick="openNotificationModal()" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-full flex items-center justify-center transition relative">
                    <i class="fa-solid fa-bell text-sm"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-book-600 rounded-full"></span>
                </button>
                <button onclick="toggleMobileMenu()" class="lg:hidden text-slate-700 text-xl p-2 focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-200 px-4 py-3 shadow-lg flex flex-col gap-2">
            <button onclick="switchTab('feed'); toggleMobileMenu();" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-slate-700 hover:bg-slate-100">
                <i class="fa-solid fa-house text-book-600 w-6"></i> 動態牆
            </button>
            <button onclick="switchTab('topics'); toggleMobileMenu();" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-slate-700 hover:bg-slate-100">
                <i class="fa-solid fa-hashtag text-book-600 w-6"></i> 話題牆
            </button>
            <button onclick="switchTab('chat'); toggleMobileMenu();" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-slate-700 hover:bg-slate-100">
                <i class="fa-solid fa-comments text-book-600 w-6"></i> 讀書會聊天室
            </button>
            <button onclick="switchTab('friends'); toggleMobileMenu();" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-slate-700 hover:bg-slate-100">
                <i class="fa-solid fa-user-group text-book-600 w-6"></i> 好友與書友
            </button>
            <button onclick="switchTab('profile'); toggleMobileMenu();" class="flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-slate-700 hover:bg-slate-100">
                <i class="fa-solid fa-id-badge text-book-600 w-6"></i> 個人檔案
            </button>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full px-2 sm:px-4 lg:px-8 py-6">

        <!-- 1. Feed Tab -->
        <div id="tab-feed" class="tab-content grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Left Sidebar -->
            <div class="hidden lg:block lg:col-span-1 space-y-4">
                <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 sticky top-20">
                    <h3 class="font-bold text-slate-700 mb-3 px-2">熱門標籤分類 (Tags)</h3>
                    <div id="tag-filter-list" class="flex flex-col gap-1">
                        <button onclick="filterByTag('全部')" class="tag-btn text-left px-3 py-2 rounded-xl text-sm font-semibold bg-book-50 text-book-700 transition flex items-center justify-between">
                            <span><i class="fa-solid fa-fire text-amber-500 mr-2"></i> 全部動態</span>
                            <span class="text-xs bg-book-200 px-2 py-0.5 rounded-full" id="count-all">6</span>
                        </button>
                        <button onclick="filterByTag('心理學')" class="tag-btn text-left px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition flex items-center justify-between">
                            <span><i class="fa-solid fa-brain text-purple-500 mr-2"></i> #心理學</span>
                            <span class="text-xs bg-slate-200 px-2 py-0.5 rounded-full">2</span>
                        </button>
                        <button onclick="filterByTag('商業理財')" class="tag-btn text-left px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition flex items-center justify-between">
                            <span><i class="fa-solid fa-chart-line text-emerald-500 mr-2"></i> #商業理財</span>
                            <span class="text-xs bg-slate-200 px-2 py-0.5 rounded-full">2</span>
                        </button>
                        <button onclick="filterByTag('文學小說')" class="tag-btn text-left px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition flex items-center justify-between">
                            <span><i class="fa-solid fa-feather text-sky-500 mr-2"></i> #文學小說</span>
                            <span class="text-xs bg-slate-200 px-2 py-0.5 rounded-full">1</span>
                        </button>
                        <button onclick="filterByTag('自我成長')" class="tag-btn text-left px-3 py-2 rounded-xl text-sm font-medium text-slate-600 hover:bg-slate-100 transition flex items-center justify-between">
                            <span><i class="fa-solid fa-seedling text-amber-600 mr-2"></i> #自我成長</span>
                            <span class="text-xs bg-slate-200 px-2 py-0.5 rounded-full">1</span>
                        </button>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-100">
                        <h4 class="font-bold text-slate-700 mb-2 px-2 text-xs uppercase tracking-wider text-slate-400">快速捷徑</h4>
                        <a href="#" onclick="switchTab('topics')" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100 transition font-medium">
                            <i class="fa-solid fa-hashtag text-book-600"></i> 熱門話題牆
                        </a>
                        <a href="#" onclick="switchTab('chat')" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100 transition font-medium">
                            <i class="fa-solid fa-comments text-book-600"></i> 公開讀書會聊天室
                        </a>
                        <a href="#" onclick="switchTab('friends')" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100 transition font-medium">
                            <i class="fa-solid fa-user-group text-book-600"></i> 尋找書友與追蹤
                        </a>
                    </div>
                </div>
            </div>

            <!-- Central Feed Stream -->
            <div class="col-span-1 lg:col-span-2 space-y-6">
                <!-- Post Creator Widget -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-5">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                        <img id="current-user-avatar-form" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" alt="頭像" class="w-11 h-11 rounded-full object-cover">
                        <div class="flex-1 bg-slate-100 hover:bg-slate-200/70 rounded-full px-5 py-3 cursor-pointer text-slate-500 text-sm font-medium transition" onclick="openPostModal()">
                            林書涵，跟大家分享今天讀了哪本好書或心得吧...
                        </div>
                    </div>
                    <div class="flex items-center justify-between pt-3 px-2">
                        <button onclick="openPostModal()" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 px-3 py-2 rounded-xl transition">
                            <i class="fa-solid fa-book text-amber-600 text-lg"></i> 書籍心得
                        </button>
                        <button onclick="openPostModal()" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 px-3 py-2 rounded-xl transition">
                            <i class="fa-solid fa-tags text-book-600 text-lg"></i> 新增 Tag 標籤
                        </button>
                        <button onclick="openPostModal()" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 px-3 py-2 rounded-xl transition">
                            <i class="fa-solid fa-image text-emerald-600 text-lg"></i> 照片 / 封面
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between px-1">
                    <h2 class="font-extrabold text-lg text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-stream text-book-600"></i> 動態牆心得分享 <span id="active-tag-label" class="text-xs bg-book-100 text-book-700 px-2.5 py-1 rounded-full font-bold">全部標籤</span>
                    </h2>
                    <div>
                        <select id="sort-select" onchange="sortFeed(this.value)" class="bg-white border border-slate-200 text-slate-600 text-xs font-semibold px-3 py-2 rounded-xl focus:outline-none">
                            <option value="latest">依發布時間排序</option>
                            <option value="popular">依按讚數排序</option>
                        </select>
                    </div>
                </div>

                <div id="posts-container" class="space-y-6"></div>
            </div>

            <!-- Right Sidebar Widgets -->
            <div class="hidden lg:block lg:col-span-1 space-y-6">
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 cursor-pointer hover:border-book-600 transition" onclick="switchTab('topics')">
                    <h3 class="font-bold text-slate-800 mb-2 flex items-center justify-between">
                        <span><i class="fa-solid fa-hashtag text-book-600 mr-2"></i> 話題牆精選</span>
                        <span class="text-xs text-book-600 font-bold">查看全部 &rarr;</span>
                    </h3>
                    <p class="text-xs text-slate-500">探索各類閱讀話題，參與專屬領域的深度討論與書單交換。</p>
                </div>

                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
                    <h3 class="font-bold text-slate-800 mb-4 flex items-center justify-between">
                        <span><i class="fa-solid fa-award text-amber-500 mr-2"></i> 本週熱門共讀書</span>
                    </h3>
                    <div class="space-y-4">
                        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-50 transition cursor-pointer">
                            <img src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=200&q=80" alt="書本" class="w-12 h-16 object-cover rounded-lg shadow">
                            <div>
                                <h4 class="font-bold text-sm text-slate-800 line-clamp-1">原子習慣</h4>
                                <p class="text-xs text-slate-500">James Clear著</p>
                                <span class="text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-bold mt-1 inline-block">24人正在討論</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-50 transition cursor-pointer">
                            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=200&q=80" alt="書本" class="w-12 h-16 object-cover rounded-lg shadow">
                            <div>
                                <h4 class="font-bold text-sm text-slate-800 line-clamp-1">被討厭的勇氣</h4>
                                <p class="text-xs text-slate-500">岸見一郎著</p>
                                <span class="text-[10px] bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full font-bold mt-1 inline-block">18人正在討論</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
                    <h3 class="font-bold text-slate-800 mb-4 flex items-center justify-between">
                        <span><i class="fa-solid fa-user-plus text-book-600 mr-2"></i> 推薦追蹤書友</span>
                    </h3>
                    <div id="suggested-friends-widget" class="space-y-3"></div>
                </div>
            </div>
        </div>

        <!-- 1.5 Topics Wall Tab (New) -->
        <div id="tab-topics" class="tab-content hidden space-y-6">
            <div class="bg-gradient-to-r from-book-600 via-amber-700 to-amber-800 rounded-3xl p-6 sm:p-10 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md inline-block mb-3">
                        <i class="fa-solid fa-hashtag mr-1"></i> 書香知音主題探索
                    </span>
                    <h1 class="text-2xl sm:text-4xl font-black">探索熱門閱讀話題牆</h1>
                    <p class="text-slate-100 text-sm sm:text-base mt-2 leading-relaxed">
                        點擊下方任一主題專區，深入瀏覽專屬的書單推薦、討論串與志同道合的閱讀夥伴！
                    </p>
                </div>
                <div class="absolute right-[-20px] bottom-[-20px] text-white/10 text-9xl pointer-events-none">
                    <i class="fa-solid fa-compass"></i>
                </div>
            </div>

            <div id="topics-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6"></div>

            <!-- Detailed Topic View Section (Shown when clicking a topic) -->
            <div id="topic-detail-view" class="hidden space-y-6 pt-4 border-t border-slate-200">
                <div class="flex items-center justify-between bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <div class="flex items-center gap-4">
                        <div id="detail-topic-icon-wrap" class="w-14 h-14 rounded-2xl flex items-center justify-center text-white text-2xl shadow">
                            <i id="detail-topic-icon" class="fa-solid fa-brain"></i>
                        </div>
                        <div>
                            <h2 id="detail-topic-title" class="text-xl sm:text-2xl font-black text-slate-900">#心理學</h2>
                            <p id="detail-topic-desc" class="text-xs sm:text-sm text-slate-500 mt-1">探索人類心智、行為模式與自我覺察的經典與新書分享。</p>
                        </div>
                    </div>
                    <button onclick="closeTopicDetail()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-xl text-sm font-semibold transition flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left"></span> 返回話題牆
                    </button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 space-y-4">
                        <h3 class="font-extrabold text-lg text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-stream text-book-600"></i> 該話題下的所有心得貼文
                        </h3>
                        <div id="topic-posts-container" class="space-y-4"></div>
                    </div>
                    <div class="space-y-4">
                        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
                            <h4 class="font-bold text-slate-800 mb-3">話題熱門統計</h4>
                            <ul class="space-y-3 text-sm text-slate-600">
                                <li class="flex justify-between"><span>討論貼文數：</span><strong id="stat-posts-count" class="text-book-600">2 篇</strong></li>
                                <li class="flex justify-between"><span>參與書友數：</span><strong class="text-slate-900">32 位</strong></li>
                                <li class="flex justify-between"><span>推薦好書數：</span><strong class="text-slate-900">5 本</strong></li>
                            </ul>
                            <button onclick="switchTab('chat')" class="w-full mt-5 bg-book-600 hover:bg-book-700 text-white font-bold py-2.5 rounded-xl text-sm transition shadow">
                                <i class="fa-solid fa-comments mr-1"></i> 加入該話題讀書聊天室
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Chat Tab -->
        <div id="tab-chat" class="tab-content hidden grid-cols-1 lg:grid-cols-4 gap-6 h-[calc(100vh-8rem)]">
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex flex-col lg:col-span-1">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                    <h3 class="font-extrabold text-slate-800 text-lg">讀書會聊天室</h3>
                    <button onclick="openNewChatModal()" class="text-xs bg-book-600 text-white font-bold px-3 py-1.5 rounded-xl hover:bg-book-700 transition">
                        <i class="fa-solid fa-plus mr-1"></i> 新聊天
                    </button>
                </div>
                <div id="chat-room-list" class="flex-1 overflow-y-auto space-y-2 pr-1"></div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 flex flex-col lg:col-span-3 overflow-hidden">
                <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
                    <div class="flex items-center gap-3">
                        <div id="active-chat-icon" class="w-10 h-10 bg-book-600 text-white rounded-xl flex items-center justify-center font-bold text-lg shadow">
                            <i class="fa-solid fa-globe"></i>
                        </div>
                        <div>
                            <h4 id="active-chat-title" class="font-bold text-slate-800">全站公開讀書會大廳</h4>
                            <p id="active-chat-desc" class="text-xs text-slate-500">線上 12 位書友正在熱烈討論中</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button class="w-9 h-9 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-600 hover:bg-slate-100 transition" title="搜尋聊天紀錄">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </button>
                    </div>
                </div>

                <div id="chat-messages-container" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 bg-slate-50/50"></div>

                <div class="p-3 sm:p-4 bg-white border-t border-slate-200 flex items-center gap-3">
                    <button class="text-slate-400 hover:text-slate-600 p-2 text-xl transition"><i class="fa-solid fa-face-smile"></i></button>
                    <button class="text-slate-400 hover:text-slate-600 p-2 text-xl transition"><i class="fa-solid fa-paperclip"></i></button>
                    <input type="text" id="chat-input" onkeypress="handleChatKeyPress(event)" placeholder="輸入想與書友交流的心得或訊息..." class="flex-1 bg-slate-100 border border-transparent rounded-full px-5 py-3 text-sm focus:bg-white focus:border-book-600 focus:outline-none transition">
                    <button onclick="sendChatMessage()" class="bg-book-600 hover:bg-book-700 text-white w-11 h-11 rounded-full flex items-center justify-center shadow-md transition transform active:scale-95">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>
                </div>
