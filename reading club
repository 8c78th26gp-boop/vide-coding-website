        function filterByTag(tag) {
            activeTagFilter = tag;
            document.getElementById('active-tag-label').innerText = '#' + tag;
            renderFeed();
        }

        function sortFeed(sortBy) {
            if (sortBy === 'popular') {
                posts.sort((a, b) => b.likes - a.likes);
            } else {
                posts.sort((a, b) => b.id - a.id);
            }
            renderFeed();
        }

        function toggleLike(postId) {
            const p = posts.find(item => item.id === postId);
            if (p) {
                if (p.likedByMe) {
                    p.likes--;
                    p.likedByMe = false;
                } else {
                    p.likes++;
                    p.likedByMe = true;
                }
                renderFeed();
                renderProfilePosts();
            }
        }

        function submitComment(postId) {
            const input = document.getElementById('comment-input-' + postId);
            if (!input || !input.value.trim()) return;

            const p = posts.find(item => item.id === postId);
            if (p) {
                p.comments.push({ author: currentUser.name, text: input.value.trim() });
                input.value = '';
                renderFeed();
                renderProfilePosts();
            }
        }

        function handleCommentKeyPress(e, postId) {
            if (e.key === 'Enter') {
                submitComment(postId);
            }
        }

        function renderChatRooms() {
            const list = document.getElementById('chat-room-list');
            list.innerHTML = '';

            chatRooms.forEach(room => {
                const isActive = room.id === currentActiveChat;
                const item = document.createElement('div');
                item.className = `p-3 rounded-2xl flex items-center justify-between cursor-pointer transition ${isActive ? 'bg-book-50 border border-book-200' : 'hover:bg-slate-100'}`;
                item.onclick = () => selectChatRoom(room.id);
                item.innerHTML = `
                    <div class="flex items-center gap-3">
